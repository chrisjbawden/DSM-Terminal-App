### Generic variables and functions
### -------------------------------

if [ -z "${SYNOPKG_PKGNAME}" ] || [ -z "${SYNOPKG_DSM_VERSION_MAJOR}" ]; then
  echo "Error: Environment variables are not set." 1>&2;
  echo "Please run me using synopkg instead. Example: \"synopkg start [packagename]\"" 1>&2;
  exit 1
fi

USER="sc-dsm-terminal"
SUDOERS_FILE="/etc/sudoers.d/dsm-terminal"


find_python3 ()
{
    for candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 python3.8 python3.7; do
        python_path=$(command -v "${candidate}" 2>/dev/null || true)
        if [ -n "${python_path}" ] && "${python_path}" -c 'import pty' >/dev/null 2>&1; then
            printf '%s\n' "${python_path}"
            return 0
        fi
    done
    return 1
}


validate_preinst ()
{
    if ! find_python3 >/dev/null 2>&1; then
        echo "DSM Terminal requires a compatible Python 3 package with the standard pty module. Install Python 3 from Package Center before continuing." 1>&2
        return 1
    fi
}



### Package specific variables and functions
### ----------------------------------------

service_postinst ()
{
    mkdir -p ${SYNOPKG_PKGVAR}/sessions
    mkdir -p ${SYNOPKG_PKGVAR}/home
    mkdir -p ${SYNOPKG_PKGVAR}/run
    chmod 700 ${SYNOPKG_PKGVAR}/sessions
    chmod 755 ${SYNOPKG_PKGVAR}/home
    chmod 755 ${SYNOPKG_PKGVAR}/run
}

service_postupgrade ()
{
    service_postinst
}


service_postuninst ()
{
    # If passwordless sudo was enabled, use that existing rule to remove
    # itself. Without the rule this safely becomes a no-op.
    if [ -x /usr/bin/sudo ]; then
        /usr/bin/sudo -n /bin/rm -f "${SUDOERS_FILE}" >/dev/null 2>&1 || true
    elif [ -x /bin/sudo ]; then
        /bin/sudo -n /bin/rm -f "${SUDOERS_FILE}" >/dev/null 2>&1 || true
    fi
}


